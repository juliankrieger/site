---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import Book from "../components/Book.astro";
import Layout from "../layouts/Layout.astro";
import Title from "../components/Title.astro";

interface OpenLibraryResponse {
    reading_log_entries: [
        {
            work: {
                title: string;
                author_names: string[];
                first_publish_year: number;
                cover_edition_key: string;
            };
        },
    ];
}

const getBooks = async (url: string) => {
    const response = await fetch(url);
    if (!response.ok) {
        throw new Error(`Failed to fetch data from ${url}`);
    }
    const json: OpenLibraryResponse = await response.json();
    const sorted = json.reading_log_entries
        .filter((e) => !!e.work.title)
        .sort((a, b) => a.work.title.localeCompare(b.work.title));
    return sorted;
};

const OPEN_LIBRARY_WANT_TO_READURL =
    "https://openlibrary.org/people/juliankrieger/books/want-to-read.json";

const OPEN_LIBRARY_ALREADY_READ_URL =
    "https://openlibrary.org/people/juliankrieger/books/already-read.json";
const wantToReadBooks = await getBooks(OPEN_LIBRARY_WANT_TO_READURL);
const alreadyReadBooks = await getBooks(OPEN_LIBRARY_ALREADY_READ_URL);
---

<Layout title="Books">
    <Title><h3>Reading List</h3></Title>
    <p>
        If you are looking to gift me something (for whatever reason), you can
        find <a
            href={"https://www.amazon.de/hz/wishlist/ls/DI5WT15AHPLM?ref_=wl_share"}
            >my Amazon wish list here</a
        >
    </p>
    <br />
    <p>
        Note: I am currently building a small webservice to display my wanted
        items here. Amazon has sadly shut down its wishlist API.
    </p>
    <p>
        Thanks to <b>Open Library</b>, you can find a list of books I want to
        read below:
    </p>
    <ul>
        {
            wantToReadBooks.map((entry) => (
                <li>
                    <Book
                        title={entry.work.title}
                        author={entry.work.author_names.join(", ")}
                        pubDate={entry.work.first_publish_year}
                        renderLink
                    />
                </li>
            ))
        }
    </ul>
    <Title><h3>Books I read</h3></Title>

    <ul>
        {
            alreadyReadBooks.map((entry) => (
                <li>
                    <Book
                        title={entry.work.title}
                        author={entry.work.author_names.join(", ")}
                        pubDate={entry.work.first_publish_year}
                    />
                </li>
            ))
        }
    </ul>
</Layout>

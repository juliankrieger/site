---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
---

<style lang="scss">
	@use "../styles/colors";
	.me-pic {
		width: 270px;
		height: 270px;
		border-radius: 5px;

		display: block;
	}

	.left-section {
		h2 {
			color: colors.$color-highlight;
			font-weight: bolder;
		}
	}

	.right-section {
	}

	main {
		display: grid;
		grid-template-columns: 1fr 2fr;
		grid-template-rows: auto;
		gap: 100px;
		padding: 20px;
	}
</style>

<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="left-section">
				<h2>Julian Krieger</h2>
				<img class="me-pic" src="/public/me.jpg" />
				<br />
				<i
					>Fullstack Developer - Site Reliability Engineer - Rust
					Enthusiast</i
				>
				<p>
					Phd Student @ <a href="https://seclab.cs.hm.edu/team/"
						>University of Applied Science Munich</a
					>
				</p>
				<p>
					Orcid: <a href="https://orcid.org/0009-0005-3000-0727"
						>0009-0005-3000-0727</a
					>
				</p>
			</section>
			<section class="right-section">
				<h2>About me</h2>
				<p>
					I am a fullstack developer with a focus on frontend
					development. I have experience in building web applications
					using modern JavaScript frameworks like Vue.js and React.js.
					I also have experience in backend development using Node.js,
					Rust, Python, and Go.
				</p>
				<br />
				<a href="/files/resume.pdf">You can find my resume here</a>
				<div>
					<h5></h5>Skills
				</div>
				<ul>
					<li>
						- Frontend Development:
						<ul>- JavaScript, TypeScript</ul>
						<ul>- React.js, Redux, Next.js</ul>
					</li>
				</ul>
				<ul>
					<li>
						- Backend Development:
						<ul>- Node.js, Rust, Python, GO, C#</ul>
						<ul>
							- Embedded Programming w/ Rust on the ESP32, where I
							sometimes contribute to Rust efforts on the
							Espressif ecosystem
						</ul>
					</li>
				</ul>
				<ul>
					<li>
						- DevSecOps
						<ul>
							- Docker, Kubernetes/K8S, Various CNCF Buzzwords
						</ul>
						<ul>- CI/CD, GitHub Actions, GitLab CI</ul>
						<ul>
							- I *extensively* use Tailscale and Ansible at work.
						</ul>
					</li>
				</ul>
			</section>
		</main>
	</body>
	<Footer />
</html>
